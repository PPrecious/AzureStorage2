@model List<AzureStorageWebApp.Models.BlobItemViewModel>

@{
    ViewData["Title"] = "Blob Storage";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">
            Azure Blob Storage
        </h1>

        <p class="text-muted mb-0">
            Container: productmedia
        </p>
    </div>

    <span class="badge text-bg-primary">
        @Model.Count blobs
    </span>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card p-3 mb-4 shadow-sm">
    <h5 class="mb-3">
        Upload Image or Multimedia
    </h5>

    <form asp-controller="Blobs"
          asp-action="Upload"
          method="post"
          enctype="multipart/form-data"
          class="row g-2">

        @Html.AntiForgeryToken()

        <div class="col-md-9">
            <input type="file"
                   name="file"
                   class="form-control"
                   accept="image/*,video/*,audio/*"
                   required />

            <div class="form-text">
                Supported formats: images, videos and audio.
                Maximum file size: 20 MB.
            </div>
        </div>

        <div class="col-md-3">
            <button type="submit"
                    class="btn btn-primary w-100">
                Upload to Blob Storage
            </button>
        </div>
    </form>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">
        Stored Multimedia
    </h3>

    <span class="text-muted">
        @Model.Count file@(Model.Count == 1 ? "" : "s")
    </span>
</div>

<div class="row g-4">

    @foreach (var blob in Model)
    {
        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                @if (blob.IsImage)
                {
                    <img src="@Url.Action(
                                            "ViewBlob",
                                            "Blobs",
                                            new { name = blob.Name })"
                         class="card-img-top media-preview"
                         alt="@blob.Name" />
                }
                else if (blob.IsVideo)
                {
                    <video class="card-img-top media-preview"
                           controls>
                        <source src="@Url.Action(
                                                    "ViewBlob",
                                                    "Blobs",
                                                    new { name = blob.Name })"
                                type="@blob.ContentType" />

                        Your browser does not support
                        video playback.
                    </video>
                }
                else if (blob.IsAudio)
                {
                    <div class="p-4 bg-light">
                        <audio controls class="w-100">
                            <source src="@Url.Action(
                                                            "ViewBlob",
                                                            "Blobs",
                                                            new { name = blob.Name })"
                                    type="@blob.ContentType" />

                            Your browser does not support
                            audio playback.
                        </audio>
                    </div>
                }
                else
                {
                    <div class="placeholder-media">
                        Multimedia file
                    </div>
                }

                <div class="card-body">

                    <h6 class="text-break">
                        @blob.Name
                    </h6>

                    <p class="small text-muted mb-3">
                        @blob.ContentType
                        ·
                        @blob.Size bytes
                    </p>

                    <div class="d-flex gap-2">

                        <a asp-controller="Blobs"
                           asp-action="ViewBlob"
                           asp-route-name="@blob.Name"
                           target="_blank"
                           rel="noopener"
                           class="btn btn-sm btn-outline-primary">
                            View / Open
                        </a>

                        <a asp-controller="Blobs"
                           asp-action="Download"
                           asp-route-name="@blob.Name"
                           class="btn btn-sm btn-secondary">
                            Download
                        </a>

                    </div>

                </div>
            </div>

        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="col-12">
            <div class="alert alert-secondary">
                No multimedia files have been stored yet.
            </div>
        </div>
    }

</div>

<style>
    .media-preview {
        width: 100%;
        height: 220px;
        object-fit: cover;
        background: #f8f9fa;
    }

    .placeholder-media {
        height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        color: #6c757d;
        font-weight: 500;
    }

    .card {
        overflow: hidden;
    }

    .card-body {
        min-height: 150px;
    }
</style>