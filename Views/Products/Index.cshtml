@model List<ProductEntity>


<div class="d-flex justify-content-between
    align-items-center mb-3">

    <div>

        <h2 class="mb-1">

            Products &amp; Inventory

        </h2>


        <p class="text-muted mb-0">

            Azure Table Storage:
            Products

        </p>

    </div>


    <span class="badge text-bg-primary">

        @Model.Count records

    </span>

</div>


<div class="card p-3 mb-4 shadow-sm">

    <h5>
        Add Product
    </h5>


    <form asp-action="Create"
          method="post"
          class="row g-2">

        @Html.AntiForgeryToken()


        <div class="col-md-3">

            <input name="ProductName"
                   class="form-control"
                   placeholder="Product name"
                   maxlength="120"
                   required />

        </div>


        <div class="col-md-2">

            <input name="Price"
                   type="number"
                   min="0"
                   step="0.01"
                   class="form-control"
                   placeholder="Price"
                   required />

        </div>


        <div class="col-md-2">

            <input name="StockQuantity"
                   type="number"
                   min="0"
                   class="form-control"
                   placeholder="Stock"
                   required />

        </div>

        <div class="col-md-1">

            <button type="submit"
                    class="btn btn-primary w-100">

                Add

            </button>

        </div>

    </form>

</div>


<div class="table-responsive">

    <table class="table table-striped
        table-hover align-middle">

        <thead>

            <tr>

                <th>
                    Partition Key
                </th>

                <th>
                    Row Key
                </th>

                <th>
                    Product
                </th>

                <th>
                    Price
                </th>

                <th>
                    Stock
                </th>

            </tr>

        </thead>


        <tbody>

            @if (Model.Count == 0)
            {
                <tr>

                    <td colspan="7"
                        class="text-center
                        text-muted py-4">

                        No products stored yet.

                    </td>

                </tr>
            }
            else
            {
                foreach (var product in Model)
                {
                    <tr>

                        <td>
                            @product.PartitionKey
                        </td>

                        <td>
                            <code>
                                @product.RowKey
                            </code>
                        </td>

                        <td>
                            @product.ProductName
                        </td>

                        <td>
                            R @product.Price.ToString("N2")
                        </td>

                        <td>
                            @product.StockQuantity
                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>

</div>