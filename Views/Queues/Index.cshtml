@model AzureStorageWebApp.Models.QueuePageViewModel

@{
    ViewData["Title"] = "Queue Storage";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">
            Azure Queue Storage
        </h1>

        <p class="text-muted mb-0">
            Queue:
            <strong>orderprocessing</strong>
        </p>
    </div>

    <span class="badge text-bg-primary fs-6">
        @Model.ApproximateMessageCount messages
    </span>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title mb-3">
            Send Transaction Message
        </h5>

        <form asp-controller="Queues"
              asp-action="Send"
              method="post"
              class="row g-3">

            @Html.AntiForgeryToken()

            <div class="col-md-3">
                <label for="type"
                       class="form-label">
                    Transaction Type
                </label>

                <select name="Type"
                        id="type"
                        class="form-select">

                    <option value="Order">
                        Order
                    </option>

                    <option value="Inventory">
                        Inventory
                    </option>

                </select>
            </div>

            <div class="col-md-7">
                <label for="message"
                       class="form-label">
                    Message
                </label>

                <input name="Message"
                       id="message"
                       class="form-control"
                       placeholder="Enter transaction message"
                       maxlength="500"
                       required />

                <div class="form-text">
                    Enter an order or inventory transaction.
                </div>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit"
                        class="btn btn-primary w-100">
                    Send Message
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <div class="d-flex justify-content-between
            align-items-center mb-3">

            <div>
                <h5 class="card-title mb-1">
                    Queue Messages
                </h5>

                <p class="text-muted small mb-0">
                    Messages currently visible in the queue.
                </p>
            </div>

            <span class="badge text-bg-secondary">
                @Model.Messages.Count visible
            </span>
        </div>

        @if (Model.Messages.Count == 0)
        {
            <div class="alert alert-warning mb-0">
                <strong>No queue messages found.</strong>
                <br />
                Use the form above to add an Order or
                Inventory transaction.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped
                    table-hover
                    align-middle mb-0">

                    <thead>
                        <tr>
                            <th style="width: 80px;">
                                #
                            </th>

                            <th>
                                Message
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (
                            var i = 0;
                            i < Model.Messages.Count;
                            i++)
                        {
                            <tr>
                                <td>
                                    @(i + 1)
                                </td>

                                <td class="text-break">
                                    <code>
                                        @Model.Messages[i]
                                    </code>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>
</div>

<style>
    .card {
        border: 0;
        border-radius: 12px;
    }

    .form-control,
    .form-select {
        min-height: 44px;
    }

    code {
        white-space: pre-wrap;
        word-break: break-word;
    }
</style>